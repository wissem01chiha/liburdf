load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "cxxopts",
    hdrs = glob(["third_party/cxxopts/include/*.hpp"]),
    includes = ["third_party/cxxopts/include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "tinyxml2",
    srcs = glob(["third_party/tinyxml2/*.cpp"]),
    hdrs = glob(["third_party/tinyxml2/*.h"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "loguru",
    srcs = glob(["third_party/loguru/*.cpp"]),
    hdrs = glob(["third_party/loguru/*.hpp"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "urdf",
    srcs = glob([
        "src/urdf/core/*.cc",
        "src/urdf/utility/*.cc",
        "src/urdf/internal/*.cc",
        "src/urdf/common/*.cc",
        "src/urdf/detail/*.cc",
    ]),
    hdrs = glob([
        "include/**/*.h",
    ]),
    includes = [
        "include/urdf",
        "include",
        "third_party"],  
    
    deps = [
        "@eigen//:eigen",       
        ":loguru",     
        ":tinyxml2", 
    ],
    visibility = ["//visibility:public"],
)


cc_library(
    name = "pybind11",
    hdrs = glob(["third_party/pybind11/include/pybind11/**/*.h"]),
    includes = ["third_party/pybind11/include"],
    visibility = ["//visibility:public"],
)


